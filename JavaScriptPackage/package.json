{
  "name": "@rhythm-game-utilities/core",
  "description": "A collection of utilities for creating rhythm games in Unity, Unreal, Godot, SDL and MonoGame.",
  "version": "1.0.0-alpha.4",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.mjs"
    }
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "scripts": {
    "test": "node --test './tests/**/*.test.mjs'"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythm-game-utilities/rhythm-game-utilities.git"
  }
}
