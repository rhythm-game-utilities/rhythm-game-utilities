{
  "name": "@rhythm-game-utilities/core",
  "description": "A collection of utilities for creating rhythm games.",
  "version": "1.0.0-alpha.6",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.mjs"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "./bin/build.sh && tsc",
    "test": "node --test './tests/**/*.test.mjs'"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "rhythm"
  ],
  "authors": [
    {
      "name": "Scott Doxey",
      "email": "hello@scottdoxey.com",
      "homepage": "http://scottdoxey.com/"
    }
  ],
  "homepage": "https://github.com/rhythm-game-utilities/rhythm-game-utilities",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythm-game-utilities/rhythm-game-utilities.git"
  }
}
